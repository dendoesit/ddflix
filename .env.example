# Copiază ca .env pe NAS și completează. .env NU se pune în git și nu se trimite nimănui.

# --- rețea
# Adresa NAS-ului văzută de telefon (pagina de admin + codul QR de pe TV)
WEB_URL=http://192.168.1.XX:8090
# Rețeaua de acasă: doar de aici se deschide pagina de admin fără cod
LAN_CIDR=192.168.1.0/24
TZ=Europe/Bucharest

# --- utilizatorul NAS-ului care deține fișierele (pe Synology: comanda `id` în SSH; de obicei 1026:100)
PUID=1000
PGID=1000

# --- căi pe NAS (exemplu Synology)
MEDIA_PATH=/volume1/media
DATA_PATH=/volume1/docker/bubuflix/data
QBT_CONFIG_PATH=/volume1/docker/bubuflix/qbittorrent

# --- FileList RSS. Pe filelist.io -> RSS: alege categoriile (ex. Seriale HD) și tipul "Download link" (feed=dl).
# Lipește URL-ul complet aici. Conține passkey-ul: nu-l pune nicăieri altundeva.
FILELIST_RSS_URL=
RSS_INTERVAL_MIN=15
# follow = doar serialele din pagina "Seriale urmărite"; all = tot ce apare în feed
RSS_MODE=follow
# Opțional: regex pe titlu, ex. 1080p   (gol = orice calitate)
RSS_INCLUDE=1080p
RSS_EXCLUDE=\b(CAM|TS|HDCAM|TELESYNC)\b
# 0 = fără limită
RSS_MAX_GB=20
# 1 = la prima pornire descarcă și ce e deja în feed
RSS_BACKFILL=0

# --- qBittorrent: lasă gol dacă folosești whitelist-ul din qbittorrent/qBittorrent/qBittorrent.conf
QBT_USER=
QBT_PASS=
TORRENT_PORT=6881

# --- performanță
MAX_TRANSCODES=1
SCAN_INTERVAL_MIN=10
